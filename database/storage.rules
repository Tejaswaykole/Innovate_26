rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ==========================================
    // RULES
    // ==========================================
    
    match /submissions/{teamId}/{fileType}/{fileName} {
      allow read: if isAuthenticated(); 
      // Only the Team Leader can upload files. We verify the user's role from Firestore.
      // File size must be less than 100MB to prevent abuse.
      allow write: if isAuthenticated() 
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.teamId == teamId
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.teamRole == 'leader'
                   && request.resource.size < 100 * 1024 * 1024;
    }

    match /certificates/{userId}/{fileName} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false; // Generated and written by backend
    }

    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
